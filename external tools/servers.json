{
  "version": 1,
  "tools": [
    {
      "name": "appsp_internal_connection",
      "file": "appsp-internal-connection.js",
      "description": "APPSP Internal Connection — bridges our server to the allindex.live.php PHP execution UI. Standalone, directory-configurable (cPanel or local). Talks to the PHP backend and returns agent responses per frontend demand.",
      "actions": [
        "ensure", "chat", "send", "conversation", "start", "new_session",
        "file_tree", "read_file", "resolve_file", "shell",
        "projects_list", "projects_create", "projects_delete", "project_info",
        "conversations", "delete_conversation", "switch_conversation",
        "rename_conversation", "clear", "compact", "fork", "abort",
        "set_mode", "status", "providers", "settings_load", "settings_save"
      ],
      "env": {
        "APPSP_PHP_URL": "http://127.0.0.1/index.live.php",
        "APPSP_PROJECT_PATH": "/frontend",
        "APPSP_PROJECT_ID": "auto-created on first run",
        "APPSP_CSRF_TOKEN": "from PHP backend session",
        "APPSP_API_KEY": "optional auth header",
        "APPSP_TIMEOUT_MS": "120000"
      },
      "config": {
        "project_path": "/frontend",
        "project_id": "auto-created on first run",
        "csrf_token": "from PHP backend session",
        "api_key": "optional auth header"
      }
    }
  ]
}
