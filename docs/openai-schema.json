    {
      "type": "function",
      "function": {
        "name": "ocr__ocr_image",
        "description": "[external:ocr] Extract text from an image file (PNG, JPG, BMP, TIFF, PDF). Uses Tesseract OCR. Supports Bengali + English.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path to the image file"
            },
            "langs": {
              "type": "string",
              "description": "Tesseract language codes (default: eng). E.g. 'eng', 'ben', 'eng+ben+ara'"
            },
            "preprocess": {
              "type": "string",
              "enum": [
                "none",
                "threshold",
                "sharpen",
                "denoise"
              ],
              "description": "Image preprocessing mode (default: none)"
            }
          },
          "required": [
            "path"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "ocr__ocr_screenshot",
        "description": "[external:ocr] Take a screenshot of the screen and extract text via OCR. Uses ffmpeg x11grab + Tesseract.",
        "parameters": {
          "type": "object",
          "properties": {
            "region": {
              "type": "string",
              "description": "Capture region: 'full' (default), or 'WxH+X+Y' (e.g. '1920x1080+0+0')"
