    {
      "type": "function",
      "function": {
        "name": "screen-recorder__screen_screenshot",
        "description": "[external:screen-recorder] Take a screenshot of the entire screen or a specific region. Returns file path.",
        "parameters": {
          "type": "object",
          "properties": {
            "region": {
              "type": "string",
              "description": "Capture region: 'full' (default) or 'WxH+X+Y' (e.g. '800x600+100+200')"
            },
            "format": {
              "type": "string",
              "enum": [
                "png",
                "jpg"
              ],
              "description": "Output format (default: png)"
            },
            "output": {
              "type": "string",
              "description": "Custom output path (optional, auto-generated if empty)"
            }
          },
          "required": []
        }
      }
