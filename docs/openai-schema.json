    {
      "type": "function",
      "function": {
        "name": "screen-recorder__screen_record_start",
        "description": "[external:screen-recorder] Start recording the screen. Returns recording ID. Use screen_record_stop to stop.",
        "parameters": {
          "type": "object",
          "properties": {
            "duration": {
              "type": "number",
              "description": "Max recording duration in seconds (default: 300 = 5 min). Auto-stops."
            },
            "fps": {
              "type": "number",
              "description": "Frames per second (default: 15). Lower = smaller file."
            },
            "region": {
              "type": "string",
              "description": "Record region: 'full' (default) or 'WxH+X+Y'"
            },
            "format": {
              "type": "string",
              "enum": [
                "mp4",
                "webm",
                "mkv"
              ],
              "description": "Output format (default: mp4)"
            },
            "output": {
              "type": "string",
              "description": "Custom output path (optional)"
            },
            "audio": {
              "type": "boolean",
              "description": "Record system audio (default: false). Requires PulseAudio."
            }
          },
          "required": []
        }
      }
    },
    {
      "type": "function",
