        "parameters": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Pattern to search (regex allowed)"
            },
            "include": {
              "type": "string",
              "description": "Optional glob filter, e.g. '**/*.js' or 'src/**' (default: all files)"
            },
            "maxResults": {
              "type": "number",
              "description": "Optional cap on matches (default 50)"
            }
          },
          "required": [
            "query"
          ]
        }
      }
