# ═══════════════════════════════════════════════════════════════════════
# ZombieCoder — Mission Barisal · Server Station  (.env.example)
# ---------------------------------------------------------------------
# কপি করো:   copy .env.example .env      (Windows)
#            cp .env.example .env         (Linux/macOS)
# তারপর <YOUR_*> জায়গায় নিজের API key / token বসাও।
# .env কখনও commit/push করো না — .gitignore-এ আছেই।
# ═══════════════════════════════════════════════════════════════════════

# ── সার্ভার ──
PORT=3000
APP_URL=http://127.0.0.1:3000
SESSION_VERIFY_URL=
UDS_PORT=5100
ALLOWED_ORIGINS=*
MAX_RATE_LIMIT=60
ALLOWED_DIRS=

# ── অ্যাডমিন/অথ (fail-closed) ──
ADMIN_API_KEY=
MCP_ADMIN_TOKEN=
# না দিলে admin endpoint deny হয়; লোকাল ডেভের জন্য:
# ADMIN_ALLOW_UNAUTHENTICATED=true
ADMIN_TOKEN=

# ── ডেটা / রেজিস্ট্রি ──
DB_REMOTE_URL=
REGISTRY_REMOTE_URL=https://raw.githubusercontent.com/sahonsrabon-os/monu_the_builder/main/registry.db
DB_SQLITE_PATH=data/models.db

# ── PROFESSIONAL PROVIDER: opencode ──
OPENCODE_BASE=
OPENCODE_API_KEY=<YOUR_OPENCODE_KEY>
OPENCODE_PRIORITY=1
OPENCODE_MODELS=

# ── groq ──
GROQ_BASE=https://api.groq.com/openai/v1
GROQ_API_KEY=<YOUR_GROQ_KEY>
GROQ_PRIORITY=2
GROQ_MODELS=

# ── gemini ──
GEMINI_BASE=
GEMINI_API_KEY=<YOUR_GEMINI_KEY>
GEMINI_PRIORITY=3
GEMINI_MODELS=

# ── ollama (লোকাল) ──
OLLAMA_BASE=http://127.0.0.1:11434
OLLAMA_API_KEY=
OLLAMA_PRIORITY=9
OLLAMA_TYPE=ollama
OLLAMA_CLOUD_API_KEY=
OLLAMA_MODELS=

# ── কাস্টম প্রোভাইডার (CUSTOM_PROVIDER_N_*) ──
CUSTOM_PROVIDER_3_ENABLED=false
CUSTOM_PROVIDER_3_NAME=
CUSTOM_PROVIDER_3_URL=
CUSTOM_PROVIDER_3_KEY=
CUSTOM_PROVIDER_3_PRIORITY=
CUSTOM_PROVIDER_3_MODELS=
CUSTOM_PROVIDER_3_TYPE=openai
CUSTOM_PROXY_API_KEY=

# ── Pusher (রিয়েল-টাইম ড্যাশবোর্ড) ──
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# ── ক্যাশ / লগ ──
CACHE_DIR=cache
CACHE_TTL=86400000
CACHE_MAX_ENTRIES=1000
LOG_DIR=logs

# ── অ্যান্টি-ডোট / টুল লুপ ──
ANTIDOTE_ENABLED=false
MAX_TOOL_ROUNDS=6