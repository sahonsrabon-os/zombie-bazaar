# ═══════════════════════════════════════════════════════════════════════
# ZombieCoder — Mission Barisal · Gateway Server  (.env.example)
# FRESH template — 2026-10-11 · Linux-ready · env-var-driven only
# ---------------------------------------------------------------------
# ব্যবহার:
#   cp .env.example .env          (Linux/macOS)
#   copy .env.example .env        (Windows)
# তারপর <YOUR_*> জায়গায় নিজের API key বসাও, তারপর:
#   node start.js --start-all -s
#
# শর্ত: Node.js ≥ 24 দরকার (node:sqlite built-in — কোনো dependency নেই)।
# .env কখনও commit/push করো না — .gitignore-এ আছে। সব সিক্রেট শুধু .env-এ।
# ═══════════════════════════════════════════════════════════════════════

# ─────────────── ১. কোর সার্ভার ───────────────
# Main HTTP listen port (সব endpoint এই পোর্টে)
PORT=3000
# Public URL (অন্য মেশিন/ডোমেইন থেকে ব্যবহার করলে এখানে বাইরের ঠিকানা দাও)
APP_URL=http://127.0.0.1:3000
# Loopback → "localhost" | বাইরের IP → "192.168.x.x" | ডোমেইন → "example.com"
# (api.js নিজে bind-host বের করে — 127.x হলে কেবল loopback bind হয়)
DOMAIN=localhost
# ডিসপ্লে-নাম / স্ট্যাটাস
SERVER_NAME=ZombieCoder
SERVER_TYPE=development
# নিজস্ব উদাহরণ শনাক্তকারী (না দিলে auto-generate হয়)
# INSTANCE_ID=

# ─────────────── ২. রান-টাইম ডিরেক্টরি (সব env-নির্ধারিত) ───────────────
DATA_DIR=data
LOG_DIR=logs
CACHE_DIR=cache
CACHE_TTL=86400000
CACHE_MAX_ENTRIES=1000
SKILLS_DIR=skills
SSOT_DIR=.zombiecoder
LOCK_DIR=data/locks
# SQLite models/agents DB (node:sqlite — zero-dependency)
DB_SQLITE_PATH=data/models.db

# ─────────────── ৩. অথ / সিকিউরিটি (fail-closed) ───────────────
# অ্যাডমিন endpoint (ডিফল্ট: টোকেন না দিলে 401)
ADMIN_TOKEN=
ADMIN_API_KEY=
ADMIN_USER=
MCP_ADMIN_TOKEN=
# লোকাল ডেভে admin লক খোলার জন্য: ADMIN_ALLOW_UNAUTHENTICATED=true
# Broker/MCP পরিচয়: admin-পাসওয়ার্ডের বিকল্প
# CORS: কমা-বাকানো origin যা-কিছু এই API-কে কল করতে পারে
ALLOWED_ORIGINS=
CORS_ORIGINS=
# এজেন্ট ফাইল-সিস্টেম scope: unrestricted (ডিফল্ট) | restricted → sandbox
#   restricted = workspace + ALLOWED_DIRS + $HOME
AGENT_FS_SCOPE=unrestricted
# restricted হলে নিচে কমা-বাকানো অতিরিক্ত ডিরেক্টরি:
ALLOWED_DIRS=
# 🧟 Body-size guard — এর চেয়ে বড় request 413 (bytes; ডিফল্ট 10 MiB)
MAX_BODY_SIZE=10485760
# Rate-limit ও cooldown
MAX_RATE_LIMIT=60
RATE_LIMIT_COOLDOWN=10000
SESSION_TTL=86400000
# shell-exec (tool) সীমা
EXEC_TIMEOUT=60000
EXEC_MAX_BUFFER=10485760

# ─────────────── ৪. PROVIDER — opencode ───────────────
OPENCODE_BASE=https://opencode.ai/inference/openai/v1
OPENCODE_API_KEY=<YOUR_OPENCODE_KEY>
OPENCODE_PRIORITY=6
OPENCODE_MODELS=
# masked pair-এর রূপ: "name:apiModel,name2:apiModel2" (কমা-বাকানো)

# ─────────────── ৫. PROVIDER — groq ───────────────
GROQ_BASE=https://api.groq.com/openai/v1
GROQ_API_KEY=<YOUR_GROQ_KEY>    # ⚠️ invalid key পেলে groq-র সব অনুরোধ fallback হবে
GROQ_PRIORITY=2
GROQ_MODELS=

# ─────────────── ৬. PROVIDER — gemini ───────────────
GEMINI_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=<YOUR_GEMINI_KEY>
GEMINI_PRIORITY=3
GEMINI_MODELS=

# ─────────────── ৭. PROVIDER — ollama (লোকাল) ───────────────
# Linux: `ollama serve` চলছে আছে? OLLAMA_BASE সেই সার্ভার
OLLAMA_BASE=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=
# ollama.com ক্লাউড (লোকাল server-এ cloud remote ব্যবহার করলে):
OLLAMA_CLOUD_API_KEY=
OLLAMA_PRIORITY=1
OLLAMA_TYPE=openai
OLLAMA_MODELS=llama3.2:latest

# ─────────────── ৮. PROVIDER — custom_N (জেনেরিক) ───────────────
# 🧟 CUSTOM_PROVIDER_N_ENABLED=false দিলে provider পুরোপুরি বাদ পড়ে
#    (এখন সত্যিই মানা হয় — 2026-10-11 ফিক্স)
CUSTOM_PROVIDER_1_ENABLED=false
CUSTOM_PROVIDER_1_NAME=
CUSTOM_PROVIDER_1_URL=
CUSTOM_PROVIDER_1_KEY=
CUSTOM_PROVIDER_1_PRIORITY=
CUSTOM_PROVIDER_1_TYPE=openai
CUSTOM_PROVIDER_1_MODELS=
# আরও যোগ করতে: একই ব্লক N=2,3,... বাড়িয়ে লিখো (কখনও cloudflare নয় — মুছে ফেলা হয়েছে)

# ─────────────── ৯. লিনাক্স - UDS (MCP সকেট) ───────────────
# Windows 없이 Linux/macOS-এ MCP মূলত UDS দিয়ে চলে।
# ডিফল্ট: <os.tmpdir()>/zombiecoder/mcp.sock  →  Linux: /tmp/zombiecoder/mcp.sock
UDS_PATH=/tmp/zombiecoder/mcp.sock
UDS_PORT=5100            # Windows TCP-fallback পোর্ট; Linux-এও তথ্যের জন্য রাখা
LOCAL_UDS_TIMEOUT=10000
# shell-exec ব্যবহৃত শেল (Linux ও Windows)
EXEC_SHELL_LINUX=/bin/bash
EXEC_SHELL_WIN=powershell.exe

# ─────────────── ১০. লোকাল LLM ব্রিজ (local-llm-bridge.js) ───────────────
# 🧟 সুরক্ষা: সকেট মোড ডিফল্ট 600 (মালিক মাত্র)। প্রয়োজনে 660/777।
BRIDGE_SOCKET_MODE=600
# CORS: খালি = loopback origin মাত্র; "*" = যেকোনো; অথবা কমা-বাকানো তালিকা
BRIDGE_ALLOWED_ORIGINS=
BRIDGE_PORT=5051
BRIDGE_SOCKET=/tmp/local-llm.sock
BRIDGE_INTERNAL_PORT=11434
BRIDGE_BACKEND=ollama
BRIDGE_MODEL=
BRIDGE_UPSTREAM_MODEL=llama3.2:latest
BRIDGE_CTX=512
BRIDGE_THREADS=4
BRIDGE_OLLAMA_URL=http://127.0.0.1:11434
# GGUF (llama.cpp) মোড হলে:
# BRIDGE_GGUF=/path/to/model.gguf
# LLAMA_SERVER_BIN=/usr/local/bin/llama-server
# MODEL_SERVER_PORT=5050

# ─────────────── ১১. MCP সার্ভার পোর্ট (external mcp/) ───────────────
# প্রতিটি লোকাল MCP-র পোর্ট; ফাঁকা রাখলে ডিফল্ট কোড-ঘোষিত মান ব্যবহার হয়
OCR_MCP_PORT=
SCREEN_MCP_PORT=
TTS_MCP_PORT=
COMBINED_MCP_PORT=
PUBLIC_API_MCP_PORT=
FB_ADS_MCP_PORT=
# দূরের MCP সার্ভার (কমা-বাকানো "<name>:<url>")
EXTERNAL_MCP_URLS=
REMOTE_MCP_SERVERS=
MCP_CLIENTS_FILE=data/mcp-clients.json
MCP_READY_TIMEOUT_MS=30000

# ─────────────── ১২. এক্সটার্নাল ইন্টিগ্রেশন ───────────────
# Pusher (রিয়েল-টাইম ড্যাশবোর্ড)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
# Facebook Ads MCP
FB_ACCESS_TOKEN=
# PHP/Frontend (ঐচ্ছিক)
FRONTEND_PORT=8081
FRONTEND_URL=http://localhost:8081
# Broker (php-broker-server.js)
BROKER_PORT=9998
BROKER_HOST=127.0.0.1

# ─────────────── ১৩. Git-কনটেন্ট সিঙ্ক (ঐচ্ছিক) ───────────────
# স্টার্টআপে টেনে নেয়া persona/skill/instruction (raw.githubusercontent URL)
GIT_PERSONAS_URL=
GIT_SKILLS_URL=
GIT_INSTRUCTIONS_URL=

# ─────────────── ১৪. আচরণ/ফ্ল্যাগ ───────────────
# অ্যান্টি-ডোট (রেকর্ড-মোড) — টুল-লুপ প্রতিরোধ
ANTIDOTE_ENABLED=false
# বাউন্ডারি-ভ্যালিডেশন (agent আউটপুট বের হওয়া নিয়ন্ত্রণ)
BOUNDARY_VALIDATE=true
# ডেভ-মডেল টেমপ্লেট (HAS_DEV_MODELS=true → অস্থায়ী ডেভ-মডেল দেখায়)
HAS_DEV_MODELS=false
# r2t (response-to-tool) ভার্চুয়াল মডেল
R2T_ENABLED=false
# হার্টবিট/ওয়াচডগ ব্যবধান (ms)
WATCHDOG_INTERVAL=60000
# ডিবেট/ব্যাক-এন্ড-ফর-এন্ড সীমা
MAX_DEBATE_ROUNDS=3
# মডেল alias — "alias:realModel" কমা-বাকানো
MODEL_ALIASES=

# ─────────────── ১৫. ব্র্যান্ডিং (API/ডিসপ্লে) ───────────────
BRANDING_ORGANIZATION=ZombieCoder
BRANDING_TAGLINE=Mission Barisal
BRANDING_WEBSITE=https://zombiecoder.my.id
BRANDING_EMAIL=infi@zombiecoder.my.id